class Solution:
    def divideArray(self, nums: List[int], k: int) -> List[List[int]]:
        nums.sort()
        l=[]
        for i in range(0,len(nums),3):
            l.append([nums[i],nums[i+1],nums[i+2]])
        for i in range(len(l)):
            if l[i][2]-l[i][0]<=k:
                continue
            else:
                return []
        return l
