# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def mergeNodes(self, head: Optional[ListNode]) -> Optional[ListNode]:
        node2=head
        while node2.next is not None:
            if node2.next.val==0:
                if node2.next is not None and node2.next.next is not None:
                    node2.next=node2.next.next
                elif node2.next.next is None and node2.next.val==0:
                    node2.next=None
                    return head
                node2=node2.next
            else:
                node2.val=node2.val+node2.next.val
                node2.next=node2.next.next    
        return head
