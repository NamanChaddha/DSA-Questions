class Solution:
    def canCompleteCircuit(self, gas: List[int], cost: List[int]) -> int:
        for i in range(len(gas)):
            gas[i]=gas[i]-cost[i]
        if sum(gas)<0:
            return -1
        c=gas[0]
        idx=0
        for i in range(1,len(gas)):
            if c>=0:
                c+=gas[i]
            else:
                idx=i
                c=0
                c+=gas[i]
        return idx
